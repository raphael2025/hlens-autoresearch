      "title": "SampleSizeParams",
      "type": "object"
    },
    "SignificanceParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-T1：多重检验校正 + 过拟合概率。\n\n两个阈值是**无量纲的 unit interval 量**，结构范围为闭区间 `[0, 1]`（ADR-0013 D-20.2）。\n这只是**结构上的合法取值范围**，不是校准值：具体数值属于 D-09 的 TBD 系列，\nPhase 4 校准后才写入具体 Profile 版本。端点 `0` 与 `1` 是否算合理配置属于校准判断，\n因此刻意保留。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "multiple_testing_method": {
          "minLength": 1,
          "title": "Multiple Testing Method",
          "type": "string"
        },
        "multiple_testing_threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Multiple Testing Threshold",
          "type": "number"
        },
        "overfitting_metric": {
          "minLength": 1,
          "title": "Overfitting Metric",
          "type": "string"
        },
        "overfitting_threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overfitting Threshold",
          "type": "number"
        },
        "trial_count_scope": {
          "minLength": 1,
          "title": "Trial Count Scope",
          "type": "string"
        },
        "reported_only_metrics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reported Only Metrics",
          "type": "array"
        },
        "multiple_testing_threshold_exact": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Multiple Testing Threshold Exact"
        },
        "overfitting_threshold_exact": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overfitting Threshold Exact"
        },
        "cscv_partitions": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cscv Partitions"
        },
        "negative_control_threshold": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negative Control Threshold"
        }
      },
      "required": [
        "multiple_testing_method",
        "multiple_testing_threshold",
        "overfitting_metric",
        "overfitting_threshold",
        "trial_count_scope"
      ],
      "title": "SignificanceParams",
      "type": "object"
    },
    "WalkForwardParams": {
      "additionalProperties": false,
      "description": "Walk-forward 配置。三个时间跨度必须严格为正（ADR-0014 §D-20.4）。\n\n本模型**不**约束跨字段关系（例如 `test_window` 与 `step` 的比例）：那取决于校准与\n方法选择，不是普适结构。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
