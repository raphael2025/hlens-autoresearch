{
  "$defs": {
    "SnapshotInfo": {
      "additionalProperties": false,
      "description": "一个表 snapshot 的中立元数据。\n\n- `parent_snapshot_id` 必须显式给出，`null` 表示该表的首个 snapshot；不得等于自身；\n- `batch_id` 与 `batch_fingerprint` 同时给出或同时为空（非 batch 产生的 snapshot，\n  例如未来的 maintenance）；\n- `added_rows <= total_rows`；\n- `committed_at` 是 catalog 记录的提交时间，只作审计。",
      "properties": {
        "schema_version": {
          "default": "2.6.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "table": {
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
          "title": "Table",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:=@+-]{0,255}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "parent_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:=@+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Snapshot Id"
        },
        "committed_at": {
          "format": "date-time",
          "title": "Committed At",
          "type": "string"
        },
        "batch_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:=@+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Batch Id"
        },
        "batch_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Batch Fingerprint"
        },
        "added_rows": {
          "minimum": 0,
          "title": "Added Rows",
          "type": "integer"
        },
        "total_rows": {
          "minimum": 0,
          "title": "Total Rows",
          "type": "integer"
        }
      },
      "required": [
        "table",
        "snapshot_id",
        "parent_snapshot_id",
        "committed_at",
        "batch_id",
        "batch_fingerprint",
        "added_rows",
        "total_rows"
      ],
      "title": "SnapshotInfo",
      "type": "object"
    },
    "TableDefinition": {
      "additionalProperties": false,
      "description": "建表请求：表身份 + 实现侧表定义的绑定（`definition_id` + SemVer + `definition_hash`）。\n\n列级 Schema、partition spec 与表属性由实现侧的版本化定义文档承载（C3），这里只以稳定、可审计、\n非代码的绑定引用它；`definition_hash` 是该文档内容的 SHA-256。",
      "properties": {
        "schema_version": {
          "default": "2.6.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "table": {
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
          "title": "Table",
          "type": "string"
        },
        "definition_id": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
          "title": "Definition Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        },
        "definition_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Definition Hash",
          "type": "string"
        }
      },
      "required": [
        "table",
        "definition_id",
        "version",
        "definition_hash"
      ],
      "title": "TableDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "一张已存在的表：创建它的定义绑定 + 当前 snapshot（显式 `null` = 尚无提交）。",
  "properties": {
    "schema_version": {
      "default": "2.6.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/TableDefinition"
    },
    "current_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotInfo"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "definition",
    "current_snapshot"
  ],
  "title": "TableInfo",
  "type": "object"
}
