{
  "$defs": {
    "GoldenOutputs": {
      "additionalProperties": false,
      "description": "固定数据快照上的参考信号 / 仓位序列，用于 Equivalence Gate。\n\n两个 `*_hash` 是被引用内容的 `ContentHash`（ADR-0015 §D-21.1）；\n`dataset_snapshot_id` 与两个 `*_uri` **不**收紧：前者的格式由外部系统（Iceberg）决定，\n后者取决于尚未决定的存储方案（D-01、D-02），按名字里有 `id` / `uri` 就套哈希类型\n只会得到错误的契约（ADR-0015 §D-21.3）。",
      "properties": {
        "schema_version": {
          "default": "2.4.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_snapshot_id": {
          "minLength": 1,
          "title": "Dataset Snapshot Id",
          "type": "string"
        },
        "signals_uri": {
          "minLength": 1,
          "title": "Signals Uri",
          "type": "string"
        },
        "signals_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signals Hash",
          "type": "string"
        },
        "positions_uri": {
          "minLength": 1,
          "title": "Positions Uri",
          "type": "string"
        },
        "positions_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Positions Hash",
          "type": "string"
        }
      },
      "required": [
        "dataset_snapshot_id",
        "signals_uri",
        "signals_hash",
        "positions_uri",
        "positions_hash"
      ],
      "title": "GoldenOutputs",
      "type": "object"
    },
    "Instrument": {
      "additionalProperties": false,
      "description": "可交易标的。跨 venue 的符号必须规范化映射。",
      "properties": {
        "schema_version": {
          "default": "2.4.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "instrument_type": {
          "$ref": "#/$defs/InstrumentType"
        },
        "base": {
          "title": "Base",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "symbol",
        "instrument_type",
        "base",
        "quote"
      ],
      "title": "Instrument",
      "type": "object"
    },
    "InstrumentType": {
      "enum": [
        "spot",
        "perpetual",
        "future",
        "option"
      ],
      "title": "InstrumentType",
      "type": "string"
    },
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "representation",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "对象引用：`{kind}:{name}@{version}`。",
      "properties": {
        "schema_version": {
          "default": "2.4.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "不可变、内容寻址的策略结论打包（ADR-0005 §2）。\n\n任何参数、依赖或代码变化 = 新 Artifact = 需重新验证。",
  "properties": {
    "schema_version": {
      "default": "2.4.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "artifact",
      "default": "artifact",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Lineage",
      "type": "array"
    },
    "strategy_spec": {
      "$ref": "#/$defs/Ref"
    },
    "dependencies": {
      "additionalProperties": false,
      "patternProperties": {
        "^(?:artifact|cost_model|dataset|event|experiment|feature|hypothesis|knowledge|outcome|profile|profile_selection_rule|representation|risk|state|strategy):[a-z][a-z0-9_]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "title": "Dependencies",
      "type": "object"
    },
    "research_code_commit": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Research Code Commit",
      "type": "string"
    },
    "research_code_tree_hash": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Research Code Tree Hash",
      "type": "string"
    },
    "experiment_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Experiment Hashes",
      "type": "array"
    },
    "validation_reports": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Validation Reports",
      "type": "array"
    },
    "golden_outputs": {
      "$ref": "#/$defs/GoldenOutputs"
    },
    "applicable_instruments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Instrument"
      },
      "title": "Applicable Instruments",
      "type": "array"
    }
  },
  "required": [
    "name",
    "version",
    "strategy_spec",
    "dependencies",
    "research_code_commit",
    "research_code_tree_hash",
    "experiment_hashes",
    "validation_reports",
    "golden_outputs"
  ],
  "title": "StrategyArtifact",
  "type": "object"
}
