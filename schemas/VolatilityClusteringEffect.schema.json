{
  "additionalProperties": false,
  "description": "GARCH(1,1) 波动率聚集：`σ²_t = omega + alpha·r²_{t-1} + beta·σ²_{t-1}`（ADR-0088 决策 4）。\n\n要求 `omega > 0`、`alpha >= 0`、`beta >= 0`、`alpha + beta < 1`（方差过程平稳）。",
  "properties": {
    "schema_version": {
      "default": "2.5.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "volatility_clustering",
      "default": "volatility_clustering",
      "title": "Kind",
      "type": "string"
    },
    "omega": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Omega",
      "type": "string"
    },
    "alpha": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Alpha",
      "type": "string"
    },
    "beta": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Beta",
      "type": "string"
    }
  },
  "required": [
    "omega",
    "alpha",
    "beta"
  ],
  "title": "VolatilityClusteringEffect",
  "type": "object"
}
