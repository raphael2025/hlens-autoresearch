{
  "$defs": {
    "LoopBudgetUsage": {
      "additionalProperties": false,
      "description": "Declared, actual, charged or overrun usage of a stage or round (``StageUsage.payload``).",
      "properties": {
        "schema_version": {
          "default": "2.2.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "trials": {
          "minimum": 0,
          "title": "Trials",
          "type": "integer"
        },
        "llm_cost_units": {
          "title": "Llm Cost Units",
          "type": "string"
        },
        "compute_seconds": {
          "title": "Compute Seconds",
          "type": "string"
        }
      },
      "required": [
        "trials",
        "llm_cost_units",
        "compute_seconds"
      ],
      "title": "LoopBudgetUsage",
      "type": "object"
    },
    "LoopStageStatus": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "REFUSED_BUDGET",
        "BUDGET_OVERRUN",
        "GUARD_VIOLATION",
        "SKIPPED"
      ],
      "title": "LoopStageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One stage of a round (``StageRecord.payload``).",
  "properties": {
    "schema_version": {
      "default": "2.2.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/LoopStageStatus"
    },
    "estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/LoopBudgetUsage"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/LoopBudgetUsage"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Summary"
    },
    "error": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    },
    "refused": {
      "items": {
        "enum": [
          "max_trials_per_round",
          "max_trials_total",
          "max_llm_cost_units",
          "max_compute_seconds"
        ],
        "type": "string"
      },
      "title": "Refused",
      "type": "array"
    },
    "overrun": {
      "anyOf": [
        {
          "$ref": "#/$defs/LoopBudgetUsage"
        },
        {
          "type": "null"
        }
      ]
    },
    "charged": {
      "anyOf": [
        {
          "$ref": "#/$defs/LoopBudgetUsage"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name",
    "status",
    "estimate",
    "usage",
    "summary",
    "error",
    "refused",
    "overrun",
    "charged"
  ],
  "title": "LoopStageRecord",
  "type": "object"
}
