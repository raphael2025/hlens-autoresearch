{
  "$defs": {
    "DatasetRef": {
      "additionalProperties": false,
      "description": "某个 Zone 的不可变数据快照引用（03-data.md §3）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "zone": {
          "$ref": "#/$defs/Zone"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "time_range_start": {
          "format": "date-time",
          "title": "Time Range Start",
          "type": "string"
        },
        "time_range_end": {
          "format": "date-time",
          "title": "Time Range End",
          "type": "string"
        }
      },
      "required": [
        "zone",
        "table",
        "snapshot_id",
        "time_range_start",
        "time_range_end"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "LlmCall": {
      "additionalProperties": false,
      "description": "LLM 调用记录：LLM 只产出数据，永不裁决（09-security.md §3）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "output_hash": {
          "title": "Output Hash",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_hash",
        "input_hash",
        "output_hash"
      ],
      "title": "LlmCall",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "对象引用：`{kind}:{name}@{version}`。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ReproducibilityTuple": {
      "additionalProperties": false,
      "description": "复现元组（06-experiment.md §2，冻结）。缺任一项则不得进入 Validation。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "hypothesis_ref": {
          "$ref": "#/$defs/Ref"
        },
        "dataset_snapshots": {
          "items": {
            "$ref": "#/$defs/DatasetRef"
          },
          "minItems": 1,
          "title": "Dataset Snapshots",
          "type": "array"
        },
        "code_commit": {
          "minLength": 7,
          "title": "Code Commit",
          "type": "string"
        },
        "plugin_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Plugin Versions",
          "type": "object"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "param_search_space": {
          "additionalProperties": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "array"
          },
          "title": "Param Search Space",
          "type": "object"
        },
        "seeds": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "array"
        },
        "environment_lock": {
          "minLength": 1,
          "title": "Environment Lock",
          "type": "string"
        },
        "constitution_version": {
          "minLength": 1,
          "title": "Constitution Version",
          "type": "string"
        },
        "validation_profile_version": {
          "minLength": 1,
          "title": "Validation Profile Version",
          "type": "string"
        },
        "validation_profile_hash": {
          "minLength": 1,
          "title": "Validation Profile Hash",
          "type": "string"
        },
        "profile_selection": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Profile Selection",
          "type": "object"
        },
        "split_spec": {
          "minLength": 1,
          "title": "Split Spec",
          "type": "string"
        },
        "cost_model_ref": {
          "$ref": "#/$defs/Ref"
        },
        "llm_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LlmCall"
          },
          "title": "Llm Calls",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_ref",
        "dataset_snapshots",
        "code_commit",
        "environment_lock",
        "constitution_version",
        "validation_profile_version",
        "validation_profile_hash",
        "split_spec",
        "cost_model_ref"
      ],
      "title": "ReproducibilityTuple",
      "type": "object"
    },
    "Zone": {
      "description": "数据分层（03-data.md §3）。",
      "enum": [
        "raw",
        "canonical",
        "feature",
        "state",
        "event",
        "outcome",
        "research_dataset"
      ],
      "title": "Zone",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "对一个 Hypothesis 的完整、可执行、可复现的检验规格。",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/Kind",
      "default": "experiment"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Lineage",
      "type": "array"
    },
    "repro": {
      "$ref": "#/$defs/ReproducibilityTuple"
    },
    "strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "risk_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "name",
    "version",
    "repro"
  ],
  "title": "ExperimentSpec",
  "type": "object"
}
