{
  "$defs": {
    "GapReason": {
      "description": "显式缺口的原因。",
      "enum": [
        "source_absent"
      ],
      "title": "GapReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "某个 symbol 在 UTC 半开区间内没有获取到对象的显式记录；`detail` 为非空证据描述。",
  "properties": {
    "schema_version": {
      "default": "2.5.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "symbol": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Symbol",
      "type": "string"
    },
    "coverage_start": {
      "format": "date-time",
      "title": "Coverage Start",
      "type": "string"
    },
    "coverage_end": {
      "format": "date-time",
      "title": "Coverage End",
      "type": "string"
    },
    "reason": {
      "$ref": "#/$defs/GapReason"
    },
    "detail": {
      "minLength": 1,
      "title": "Detail",
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "coverage_start",
    "coverage_end",
    "reason",
    "detail"
  ],
  "title": "CoverageGap",
  "type": "object"
}
