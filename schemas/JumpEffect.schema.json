{
  "additionalProperties": false,
  "description": "Poisson 跳跃：每分钟以 `intensity_per_minute` 的概率出现一次跳跃（ADR-0088 决策 4）。\n\n`intensity_per_minute` 在 (0, 1) 之间，`jump_scale > 0`；跳幅由种子确定性生成。",
  "properties": {
    "schema_version": {
      "default": "2.4.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "jump",
      "default": "jump",
      "title": "Kind",
      "type": "string"
    },
    "intensity_per_minute": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Intensity Per Minute",
      "type": "string"
    },
    "jump_scale": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Jump Scale",
      "type": "string"
    }
  },
  "required": [
    "intensity_per_minute",
    "jump_scale"
  ],
  "title": "JumpEffect",
  "type": "object"
}
