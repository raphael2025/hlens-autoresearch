{
  "$defs": {
    "BenchmarkParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-T4：空模型为主，市场基准按类别适用。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "null_model": {
          "minLength": 1,
          "title": "Null Model",
          "type": "string"
        },
        "null_model_simulations": {
          "exclusiveMinimum": 0,
          "title": "Null Model Simulations",
          "type": "integer"
        },
        "null_model_percentile": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Null Model Percentile",
          "type": "number"
        },
        "market_benchmark_rule": {
          "minLength": 1,
          "title": "Market Benchmark Rule",
          "type": "string"
        },
        "inverse_control_reported": {
          "title": "Inverse Control Reported",
          "type": "boolean"
        }
      },
      "required": [
        "null_model",
        "null_model_simulations",
        "null_model_percentile",
        "market_benchmark_rule",
        "inverse_control_reported"
      ],
      "title": "BenchmarkParams",
      "type": "object"
    },
    "CostStressParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-R4 与 A6。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "cost_model": {
          "$ref": "#/$defs/Ref"
        },
        "fill_assumption": {
          "minLength": 1,
          "title": "Fill Assumption",
          "type": "string"
        },
        "stress_multipliers": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Stress Multipliers",
          "type": "array"
        },
        "reported_only_multipliers": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Reported Only Multipliers",
          "type": "array"
        },
        "delay_stress_bars": {
          "minimum": 0,
          "title": "Delay Stress Bars",
          "type": "integer"
        },
        "min_breakeven_cost_multiple": {
          "exclusiveMinimum": 0.0,
          "title": "Min Breakeven Cost Multiple",
          "type": "number"
        }
      },
      "required": [
        "cost_model",
        "fill_assumption",
        "stress_multipliers",
        "delay_stress_bars",
        "min_breakeven_cost_multiple"
      ],
      "title": "CostStressParams",
      "type": "object"
    },
    "DataSplitParams": {
      "additionalProperties": false,
      "description": "对应 Constitution 第四章。封存区使用固定日期边界，不随运行时间滚动。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "research_window_start": {
          "format": "date",
          "title": "Research Window Start",
          "type": "string"
        },
        "sealed_oos_boundary": {
          "format": "date",
          "title": "Sealed Oos Boundary",
          "type": "string"
        },
        "sealed_oos_length": {
          "format": "duration",
          "title": "Sealed Oos Length",
          "type": "string"
        },
        "sealed_oos_max_extension": {
          "format": "duration",
          "title": "Sealed Oos Max Extension",
          "type": "string"
        },
        "embargo": {
          "format": "duration",
          "title": "Embargo",
          "type": "string"
        },
        "walk_forward": {
          "$ref": "#/$defs/WalkForwardParams"
        }
      },
      "required": [
        "research_window_start",
        "sealed_oos_boundary",
        "sealed_oos_length",
        "sealed_oos_max_extension",
        "embargo",
        "walk_forward"
      ],
      "title": "DataSplitParams",
      "type": "object"
    },
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "LifecycleParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-G3 与 ADR-0006（Q-6 仍开放）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "paper_period": {
          "format": "duration",
          "title": "Paper Period",
          "type": "string"
        },
        "paper_acceptance_rule": {
          "minLength": 1,
          "title": "Paper Acceptance Rule",
          "type": "string"
        },
        "degradation_thresholds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Degradation Thresholds",
          "type": "object"
        }
      },
      "required": [
        "paper_period",
        "paper_acceptance_rule"
      ],
      "title": "LifecycleParams",
      "type": "object"
    },
    "ParameterStabilityParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-R1。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "neighborhood_definition": {
          "minLength": 1,
          "title": "Neighborhood Definition",
          "type": "string"
        },
        "min_neighborhood_performance_ratio": {
          "title": "Min Neighborhood Performance Ratio",
          "type": "number"
        },
        "min_positive_neighbor_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Positive Neighbor Fraction",
          "type": "number"
        },
        "time_alignment_offsets": {
          "default": [],
          "items": {
            "format": "duration",
            "type": "string"
          },
          "title": "Time Alignment Offsets",
          "type": "array"
        }
      },
      "required": [
        "neighborhood_definition",
        "min_neighborhood_performance_ratio",
        "min_positive_neighbor_fraction"
      ],
      "title": "ParameterStabilityParams",
      "type": "object"
    },
    "ProfileScope": {
      "additionalProperties": false,
      "description": "Profile 的适用范围；与选择规则（ProfileSelectionRule）匹配。\n\n`research_class` 的取值集合（例如按持仓周期划分）仍未决定（D-09 H-7），\n因此这里只约束为标识符，不预设分类。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "venue": {
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        },
        "symbol": {
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "minLength": 1,
          "title": "Timeframe",
          "type": "string"
        },
        "research_class": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Research Class",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "symbol",
        "timeframe",
        "research_class"
      ],
      "title": "ProfileScope",
      "type": "object"
    },
    "ProfileStatus": {
      "enum": [
        "draft",
        "frozen",
        "superseded"
      ],
      "title": "ProfileStatus",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Step 2 冻结依据。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "calibration_report": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Report"
        },
        "approval_adr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Adr"
        },
        "previous_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Version"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "对象引用：`{kind}:{name}@{version}`。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SampleSizeParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-T2：以有效独立样本计。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "min_effective_trades_in_sample": {
          "exclusiveMinimum": 0,
          "title": "Min Effective Trades In Sample",
          "type": "integer"
        },
        "min_effective_trades_out_of_sample": {
          "exclusiveMinimum": 0,
          "title": "Min Effective Trades Out Of Sample",
          "type": "integer"
        },
        "min_effective_trades_per_state": {
          "exclusiveMinimum": 0,
          "title": "Min Effective Trades Per State",
          "type": "integer"
        },
        "effective_sample_method": {
          "minLength": 1,
          "title": "Effective Sample Method",
          "type": "string"
        },
        "min_regime_coverage": {
          "minLength": 1,
          "title": "Min Regime Coverage",
          "type": "string"
        }
      },
      "required": [
        "min_effective_trades_in_sample",
        "min_effective_trades_out_of_sample",
        "min_effective_trades_per_state",
        "effective_sample_method",
        "min_regime_coverage"
      ],
      "title": "SampleSizeParams",
      "type": "object"
    },
    "SignificanceParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-T1：多重检验校正 + 过拟合概率。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "multiple_testing_method": {
          "minLength": 1,
          "title": "Multiple Testing Method",
          "type": "string"
        },
        "multiple_testing_threshold": {
          "title": "Multiple Testing Threshold",
          "type": "number"
        },
        "overfitting_metric": {
          "minLength": 1,
          "title": "Overfitting Metric",
          "type": "string"
        },
        "overfitting_threshold": {
          "title": "Overfitting Threshold",
          "type": "number"
        },
        "trial_count_scope": {
          "minLength": 1,
          "title": "Trial Count Scope",
          "type": "string"
        },
        "reported_only_metrics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reported Only Metrics",
          "type": "array"
        }
      },
      "required": [
        "multiple_testing_method",
        "multiple_testing_threshold",
        "overfitting_metric",
        "overfitting_threshold",
        "trial_count_scope"
      ],
      "title": "SignificanceParams",
      "type": "object"
    },
    "WalkForwardParams": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "train_window": {
          "format": "duration",
          "title": "Train Window",
          "type": "string"
        },
        "test_window": {
          "format": "duration",
          "title": "Test Window",
          "type": "string"
        },
        "step": {
          "format": "duration",
          "title": "Step",
          "type": "string"
        },
        "min_positive_window_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Positive Window Fraction",
          "type": "number"
        },
        "max_single_window_pnl_share": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Max Single Window Pnl Share",
          "type": "number"
        }
      },
      "required": [
        "train_window",
        "test_window",
        "step",
        "min_positive_window_fraction",
        "max_single_window_pnl_share"
      ],
      "title": "WalkForwardParams",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "按\"标的 × 周期 × 研究类别\"给出的版本化阈值集合。\n\n不可变性：`status = frozen` 的版本永不修改；修正 = 新版本（Constitution C-A5）。\n完整性：五类门槛必须齐全，否则 Profile 无效（Constitution C-A7）。",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/Kind",
      "default": "profile"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Lineage",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ProfileStatus",
      "default": "draft"
    },
    "scope": {
      "$ref": "#/$defs/ProfileScope"
    },
    "data_split": {
      "$ref": "#/$defs/DataSplitParams"
    },
    "sample_size": {
      "$ref": "#/$defs/SampleSizeParams"
    },
    "significance": {
      "$ref": "#/$defs/SignificanceParams"
    },
    "benchmark": {
      "$ref": "#/$defs/BenchmarkParams"
    },
    "parameter_stability": {
      "$ref": "#/$defs/ParameterStabilityParams"
    },
    "cost_stress": {
      "$ref": "#/$defs/CostStressParams"
    },
    "lifecycle": {
      "$ref": "#/$defs/LifecycleParams"
    },
    "inconclusive_bands": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Inconclusive Bands",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "default": {
        "schema_version": "1.0.0",
        "calibration_report": null,
        "approval_adr": null,
        "previous_version": null
      }
    }
  },
  "required": [
    "name",
    "version",
    "scope",
    "data_split",
    "sample_size",
    "significance",
    "benchmark",
    "parameter_stability",
    "cost_stress",
    "lifecycle"
  ],
  "title": "ValidationProfile",
  "type": "object"
}
