{
  "$defs": {
    "InstrumentType": {
      "enum": [
        "spot",
        "perpetual",
        "future",
        "option"
      ],
      "title": "InstrumentType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "可交易标的。跨 venue 的符号必须规范化映射。",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "venue": {
      "title": "Venue",
      "type": "string"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "instrument_type": {
      "$ref": "#/$defs/InstrumentType"
    },
    "base": {
      "title": "Base",
      "type": "string"
    },
    "quote": {
      "title": "Quote",
      "type": "string"
    }
  },
  "required": [
    "venue",
    "symbol",
    "instrument_type",
    "base",
    "quote"
  ],
  "title": "Instrument",
  "type": "object"
}
