{
  "additionalProperties": false,
  "description": "一根 Canonical 价格 bar：区间 `[interval_start, interval_end)`，区间结束后才可用。",
  "properties": {
    "schema_version": {
      "default": "2.3.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "interval_start": {
      "format": "date-time",
      "title": "Interval Start",
      "type": "string"
    },
    "interval_end": {
      "format": "date-time",
      "title": "Interval End",
      "type": "string"
    },
    "available_time": {
      "format": "date-time",
      "title": "Available Time",
      "type": "string"
    },
    "open": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Open",
      "type": "string"
    },
    "high": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "High",
      "type": "string"
    },
    "low": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Low",
      "type": "string"
    },
    "close": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Close",
      "type": "string"
    }
  },
  "required": [
    "interval_start",
    "interval_end",
    "available_time",
    "open",
    "high",
    "low",
    "close"
  ],
  "title": "OutcomePriceBar",
  "type": "object"
}
