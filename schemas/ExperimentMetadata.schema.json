{
  "$defs": {
    "GateResult": {
      "additionalProperties": false,
      "description": "单个验证门的结构化结果（07-validation.md §2）。\n\n`threshold_source` 指向 Validation Profile 中的字段路径：阈值不得写死在流水线里。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "gate_id": {
          "minLength": 1,
          "title": "Gate Id",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "threshold_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Source"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "gate_id",
        "metric",
        "value",
        "verdict"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "LlmCall": {
      "additionalProperties": false,
      "description": "LLM 调用记录：LLM 只产出数据，永不裁决（09-security.md §3）。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "output_hash": {
          "title": "Output Hash",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_hash",
        "input_hash",
        "output_hash"
      ],
      "title": "LlmCall",
      "type": "object"
    },
    "OosUnsealing": {
      "additionalProperties": false,
      "description": "封存样本外的开封记录（Constitution C-S2）；不可撤销。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "unsealed_at": {
          "format": "date-time",
          "title": "Unsealed At",
          "type": "string"
        },
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "family_unseal_count": {
          "exclusiveMinimum": 0,
          "title": "Family Unseal Count",
          "type": "integer"
        }
      },
      "required": [
        "unsealed_at",
        "approved_by",
        "family_unseal_count"
      ],
      "title": "OosUnsealing",
      "type": "object"
    },
    "ProfileSelectionKey": {
      "additionalProperties": false,
      "description": "选择输入：标的、周期、预登记的研究类别。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "venue": {
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        },
        "symbol": {
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "minLength": 1,
          "title": "Timeframe",
          "type": "string"
        },
        "research_class": {
          "minLength": 1,
          "title": "Research Class",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "symbol",
        "timeframe",
        "research_class"
      ],
      "title": "ProfileSelectionKey",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "每个实验实际使用的规则版本与配置（06-experiment.md §3）。\n\n追加式、不可修改；与 ValidationReport 一起构成审计证据。",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "experiment_hash": {
      "minLength": 1,
      "title": "Experiment Hash",
      "type": "string"
    },
    "constitution_version": {
      "minLength": 1,
      "title": "Constitution Version",
      "type": "string"
    },
    "validation_profile_version": {
      "minLength": 1,
      "title": "Validation Profile Version",
      "type": "string"
    },
    "validation_profile_hash": {
      "minLength": 1,
      "title": "Validation Profile Hash",
      "type": "string"
    },
    "profile_selection_rule_version": {
      "minLength": 1,
      "title": "Profile Selection Rule Version",
      "type": "string"
    },
    "profile_selection_key": {
      "$ref": "#/$defs/ProfileSelectionKey"
    },
    "hypothesis_family_id": {
      "minLength": 1,
      "title": "Hypothesis Family Id",
      "type": "string"
    },
    "trial_index": {
      "exclusiveMinimum": 0,
      "title": "Trial Index",
      "type": "integer"
    },
    "family_trial_count": {
      "exclusiveMinimum": 0,
      "title": "Family Trial Count",
      "type": "integer"
    },
    "declared_research_class": {
      "minLength": 1,
      "title": "Declared Research Class",
      "type": "string"
    },
    "realized_holding_stats": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Realized Holding Stats",
      "type": "object"
    },
    "gate_results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gate Results",
      "type": "array"
    },
    "oos_unsealing": {
      "anyOf": [
        {
          "$ref": "#/$defs/OosUnsealing"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "llm_calls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LlmCall"
      },
      "title": "Llm Calls",
      "type": "array"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "experiment_hash",
    "constitution_version",
    "validation_profile_version",
    "validation_profile_hash",
    "profile_selection_rule_version",
    "profile_selection_key",
    "hypothesis_family_id",
    "trial_index",
    "family_trial_count",
    "declared_research_class"
  ],
  "title": "ExperimentMetadata",
  "type": "object"
}
