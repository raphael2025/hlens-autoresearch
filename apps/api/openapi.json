{
  "components": {
    "schemas": {
      "ApiError": {
        "description": "The error body of every status this API raises itself (400/404/422/500/502/503).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ContractNames": {
        "description": "``GET /contracts``: the registered contract model names, sorted.",
        "items": {
          "type": "string"
        },
        "title": "ContractNames",
        "type": "array"
      },
      "EvidenceLevel": {
        "description": "\u77e5\u8bc6\u6761\u76ee\u7684\u8bc1\u636e\u7b49\u7ea7\uff08docs/research/knowledge-base.md\uff09\u3002",
        "enum": [
          "E0",
          "E1",
          "E2",
          "E3",
          "E4"
        ],
        "title": "EvidenceLevel",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "description": "``GET /health``.",
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "api_version"
        ],
        "title": "Health",
        "type": "object"
      },
      "InvalidReport": {
        "description": "A report file the store found but could not serve: its ``id`` (file stem) and why.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "title": "InvalidReport",
        "type": "object"
      },
      "JobList": {
        "description": "``GET /jobs``: every job in the order of its first start, plus the verified chain tip.",
        "properties": {
          "head_hash": {
            "title": "Head Hash",
            "type": "string"
          },
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobView"
            },
            "title": "Jobs",
            "type": "array"
          },
          "lines": {
            "title": "Lines",
            "type": "integer"
          }
        },
        "required": [
          "jobs",
          "head_hash",
          "lines"
        ],
        "title": "JobList",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "succeeded",
          "failed",
          "interrupted"
        ],
        "type": "string"
      },
      "JobView": {
        "description": "One job of the worker's results journal (``apps.worker.jobs.JobRecord``), read-only.\n\n``status`` is ``succeeded``, ``failed`` or ``interrupted`` (started without a recorded result:\nrunning, or died and awaiting review / an idempotent re-run). ``attempts`` / ``result`` /\n``error`` come from the ``job_result`` line and are ``null`` while interrupted.",
        "properties": {
          "attempts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempts"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "first_seq": {
            "title": "First Seq",
            "type": "integer"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "last_seq": {
            "title": "Last Seq",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "params": {
            "title": "Params"
          },
          "reruns": {
            "title": "Reruns",
            "type": "integer"
          },
          "result": {
            "title": "Result"
          },
          "starts": {
            "title": "Starts",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        },
        "required": [
          "job_id",
          "name",
          "params",
          "status",
          "attempts",
          "result",
          "error",
          "starts",
          "reruns",
          "first_seq",
          "last_seq"
        ],
        "title": "JobView",
        "type": "object"
      },
      "Kind": {
        "description": "\u53ef\u7248\u672c\u5316\u5bf9\u8c61\u7684\u7c7b\u578b\uff0802-domain.md \u00a71\uff09\u3002",
        "enum": [
          "dataset",
          "representation",
          "feature",
          "state",
          "event",
          "outcome",
          "strategy",
          "risk",
          "cost_model",
          "experiment",
          "hypothesis",
          "knowledge",
          "artifact",
          "profile",
          "profile_selection_rule"
        ],
        "title": "Kind",
        "type": "string"
      },
      "KnowledgeItem": {
        "additionalProperties": false,
        "description": "\u516c\u5f00\u6765\u6e90\u4e2d\u7684**\u5f85\u68c0\u9a8c\u4e3b\u5f20**\uff0c\u4e0d\u662f\u5df2\u9a8c\u8bc1\u7ed3\u8bba\u3002",
        "properties": {
          "claim": {
            "minLength": 1,
            "title": "Claim",
            "type": "string"
          },
          "conditions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Conditions",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "evidence_level": {
            "$ref": "#/components/schemas/EvidenceLevel"
          },
          "kind": {
            "const": "knowledge",
            "default": "knowledge",
            "title": "Kind",
            "type": "string"
          },
          "license": {
            "title": "License",
            "type": "string"
          },
          "lineage": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "title": "Lineage",
            "type": "array"
          },
          "links": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "title": "Links",
            "type": "array"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Name",
            "type": "string"
          },
          "schema_version": {
            "default": "2.0.0",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
            "title": "Schema Version",
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/KnowledgeStatus",
            "default": "unverified"
          },
          "version": {
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "source",
          "license",
          "claim",
          "evidence_level"
        ],
        "title": "KnowledgeItem",
        "type": "object"
      },
      "KnowledgeQuery": {
        "additionalProperties": false,
        "description": "\u4e00\u6b21\u77e5\u8bc6\u68c0\u7d22\u3002\n\n- `terms`\uff1a\u5168\u90e8\u987b\u51fa\u73b0\u5728\u6761\u76ee `name` / `claim` / `conditions` \u4e2d\uff08\u4e0d\u533a\u5206\u5927\u5c0f\u5199\uff0cAND \u8bed\u4e49\uff09\uff1b\n- `name_prefix`\uff1a\u5e93\u524d\u7f00\uff0c\u5982 `strategy_`\u3001`factor_`\u3001`state_`\uff08\u7a7a = \u4e0d\u9650\uff09\uff1b\n- `evidence_at_least`\uff1a\u53ea\u8fd4\u56de\u8bc1\u636e\u7b49\u7ea7\u4e0d\u4f4e\u4e8e\u8be5\u503c\u7684\u6761\u76ee\uff08\u7a7a = \u4e0d\u9650\uff09\uff1b\n- `statuses`\uff1a\u53ea\u8fd4\u56de\u8fd9\u4e9b\u72b6\u6001\uff08\u7a7a = \u4e0d\u9650\uff09\uff1b\n- `limit`\uff1a\u7ed3\u679c\u4e0a\u9650\u3002",
        "properties": {
          "evidence_at_least": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvidenceLevel"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "default": 50,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "name_prefix": {
            "default": "",
            "title": "Name Prefix",
            "type": "string"
          },
          "schema_version": {
            "default": "2.0.0",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
            "title": "Schema Version",
            "type": "string"
          },
          "statuses": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/KnowledgeStatus"
            },
            "title": "Statuses",
            "type": "array"
          },
          "terms": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Terms",
            "type": "array"
          }
        },
        "title": "KnowledgeQuery",
        "type": "object"
      },
      "KnowledgeResult": {
        "additionalProperties": false,
        "description": "\u4e00\u6b21\u68c0\u7d22\u7684\u7ed3\u679c\uff1a\u6761\u76ee\u6309 `name`\u3001`version` \u89c4\u8303\u6392\u5e8f\uff1b\u6bcf\u6761\u90fd\u6709\u51fa\u5904\u4e0e\u8bb8\u53ef\u3002",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeItem"
            },
            "title": "Items",
            "type": "array"
          },
          "provider": {
            "pattern": "^[a-z][a-z0-9_]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
            "title": "Provider",
            "type": "string"
          },
          "query_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Query Hash",
            "type": "string"
          },
          "result_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Result Hash",
            "type": "string"
          },
          "schema_version": {
            "default": "2.0.0",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "query_hash",
          "provider",
          "items",
          "result_hash"
        ],
        "title": "KnowledgeResult",
        "type": "object"
      },
      "KnowledgeStatus": {
        "enum": [
          "unverified",
          "supported",
          "contradicted",
          "inconclusive"
        ],
        "title": "KnowledgeStatus",
        "type": "string"
      },
      "LifecycleTransition": {
        "description": "One allowed lifecycle transition (``GET /lifecycle/transitions``), ``{\"from\", \"to\"}``.",
        "properties": {
          "from": {
            "title": "From",
            "type": "string"
          },
          "to": {
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "title": "LifecycleTransition",
        "type": "object"
      },
      "Ref": {
        "additionalProperties": false,
        "description": "\u5bf9\u8c61\u5f15\u7528\uff1a`{kind}:{name}@{version}`\u3002",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Name",
            "type": "string"
          },
          "schema_version": {
            "default": "2.0.0",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
            "title": "Schema Version",
            "type": "string"
          },
          "version": {
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "version"
        ],
        "title": "Ref",
        "type": "object"
      },
      "ReportEnvelope": {
        "description": "The minimal envelope every report kind is served through.",
        "properties": {
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "created": {
            "format": "date-time",
            "title": "Created",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ReportKind"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "kind",
          "id",
          "created",
          "payload",
          "content_hash"
        ],
        "title": "ReportEnvelope",
        "type": "object"
      },
      "ReportKind": {
        "description": "The report kinds the console serves ((a)-(d), Phase 9 gate calibration evidence, and the\nPhase 10 router stop / Phase 2 state diagnostics / Phase 3 event statistics records).",
        "enum": [
          "validation_report",
          "research_loop_round",
          "state_strategy_matrix",
          "router_paper_run",
          "gate_calibration",
          "router_stop",
          "state_diagnostics",
          "event_statistics"
        ],
        "title": "ReportKind",
        "type": "string"
      },
      "ReportListing": {
        "description": "``GET /reports/{kind}``: the well-formed reports (newest first) and every file skipped as\nmalformed (by id), so a corrupt file is reported instead of silently dropped.",
        "properties": {
          "invalid": {
            "items": {
              "$ref": "#/components/schemas/InvalidReport"
            },
            "title": "Invalid",
            "type": "array"
          },
          "kind": {
            "$ref": "#/components/schemas/ReportKind"
          },
          "reports": {
            "items": {
              "$ref": "#/components/schemas/ReportEnvelope"
            },
            "title": "Reports",
            "type": "array"
          }
        },
        "required": [
          "kind",
          "reports",
          "invalid"
        ],
        "title": "ReportListing",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "HLENS-AutoResearch API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/contracts": {
      "get": {
        "operationId": "contracts_contracts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractNames"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Contracts"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/jobs": {
      "get": {
        "operationId": "list_jobs_jobs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "List Jobs"
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "get_job_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Job"
      }
    },
    "/knowledge/search": {
      "post": {
        "operationId": "knowledge_search_knowledge_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KnowledgeQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Knowledge Search"
      }
    },
    "/lifecycle/transitions": {
      "get": {
