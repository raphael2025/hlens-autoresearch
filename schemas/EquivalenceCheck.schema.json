{
  "additionalProperties": false,
  "description": "生产实现与 golden outputs 的一致性检查（ADR-0005 §5）。",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "production_code_hash": {
      "minLength": 7,
      "title": "Production Code Hash",
      "type": "string"
    },
    "signals_match": {
      "title": "Signals Match",
      "type": "boolean"
    },
    "positions_match": {
      "title": "Positions Match",
      "type": "boolean"
    },
    "tolerance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tolerance"
    }
  },
  "required": [
    "artifact_id",
    "production_code_hash",
    "signals_match",
    "positions_match"
  ],
  "title": "EquivalenceCheck",
  "type": "object"
}
