{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.2.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "topic": {
      "pattern": "^[a-z][a-z0-9_.]*$",
      "title": "Topic",
      "type": "string"
    },
    "key": {
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "message_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Message Id",
      "type": "string"
    }
  },
  "required": [
    "topic",
    "key",
    "payload",
    "message_id"
  ],
  "title": "BusMessage",
  "type": "object"
}
