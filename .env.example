# Phase 1 typed settings placeholders (03-data.md §6.2).
# Copy to `.env` and replace placeholders. Do not commit real credentials.

HLENS_WAREHOUSE_URI=file:///absolute/path/to/hlens-autoresearch/data/warehouse
HLENS_STAGING_URI=file:///absolute/path/to/hlens-autoresearch/data/warehouse/staging
HLENS_CATALOG_URI=postgresql://hlens:CHANGE_ME_NOT_A_REAL_SECRET@127.0.0.1:5432/hlens_catalog
HLENS_CATALOG_NAME=hlens
HLENS_HTTP_CONNECT_TIMEOUT_SECONDS=10
HLENS_HTTP_READ_TIMEOUT_SECONDS=60
HLENS_HTTP_MAX_RETRIES=5
HLENS_HTTP_USER_AGENT=hlens-autoresearch/0.0.0
HLENS_BINANCE_ARCHIVE_BASE_URL=https://data.binance.vision
HLENS_BINANCE_MARKET_DATA_BASE_URL=https://data-api.binance.vision
