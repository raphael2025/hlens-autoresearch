{
  "$defs": {
    "StateValue": {
      "additionalProperties": false,
      "description": "一个评估时刻的状态。\n\n- `state`：必填；`None` 表示显式\"不可计算\"（历史不足等），不填补；\n- `inputs_used`：识别该状态实际使用的 Feature 值个数；为 0 当且仅当 `latest_input_time` 为空，\n  且此时 `state` 必须为 `None`；\n- `latest_input_time`：所用 Feature 值中最大的 `evaluation_time`，不晚于 `evaluation_time`。",
      "properties": {
        "schema_version": {
          "default": "2.6.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "evaluation_time": {
          "format": "date-time",
          "title": "Evaluation Time",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State"
        },
        "inputs_used": {
          "minimum": 0,
          "title": "Inputs Used",
          "type": "integer"
        },
        "latest_input_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Input Time"
        }
      },
      "required": [
        "evaluation_time",
        "state",
        "inputs_used"
      ],
      "title": "StateValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "一次 `compute` 的结果（即一份 State 序列）。\n\n- `request_hash`：请求的 `content_hash()`；`provider` / `provider_hash`：Provider 的\n  `name@version` 与其 descriptor 的内容哈希；\n- `values`：非空，`evaluation_time` 严格升序；与请求的 `evaluation_times` 一一对应（由\n  `check_answers` 对照请求检查）；\n- `result_hash`：以上内容的规范 JSON SHA-256，构造时复核。",
  "properties": {
    "schema_version": {
      "default": "2.6.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "provider": {
      "pattern": "^[a-z][a-z0-9_]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Provider",
      "type": "string"
    },
    "provider_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Hash",
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/StateValue"
      },
      "minItems": 1,
      "title": "Values",
      "type": "array"
    },
    "result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Hash",
      "type": "string"
    }
  },
  "required": [
    "request_hash",
    "provider",
    "provider_hash",
    "values",
    "result_hash"
  ],
  "title": "StateResult",
  "type": "object"
}
