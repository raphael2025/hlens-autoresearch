          "type": "string"
        },
        "research_class": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Research Class",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "symbol",
        "timeframe",
        "research_class"
      ],
      "title": "ProfileScope",
      "type": "object"
    },
    "ProfileStatus": {
