        "min_positive_neighbor_fraction"
      ],
      "title": "ParameterStabilityParams",
      "type": "object"
    },
    "ProfileScope": {
      "additionalProperties": false,
      "description": "Profile 的适用范围；与选择规则（ProfileSelectionRule）匹配。\n\n`research_class` 的取值集合（例如按持仓周期划分）仍未决定（D-09 H-7），\n因此这里只约束为标识符，不预设分类。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "venue": {
          "minLength": 1,
