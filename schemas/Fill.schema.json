{
  "additionalProperties": false,
  "description": "一笔模拟成交（不是订单；v1 没有任何下单能力）。\n\n`fill_time`（成交 bar 的 `interval_start`）不得早于 `decision_time`——结构性无未来函数。\n`slippage_cost = |quantity| × |fill_price − reference_price|`。",
  "properties": {
    "schema_version": {
      "default": "2.2.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "instrument": {
      "minLength": 1,
      "title": "Instrument",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "fill_time": {
      "format": "date-time",
      "title": "Fill Time",
      "type": "string"
    },
    "reference_price": {
      "gt": 0,
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Reference Price",
      "type": "string"
    },
    "fill_price": {
      "gt": 0,
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Fill Price",
      "type": "string"
    },
    "quantity": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Quantity",
      "type": "string"
    },
    "fee": {
      "ge": 0,
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Fee",
      "type": "string"
    },
    "slippage_cost": {
      "ge": 0,
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Slippage Cost",
      "type": "string"
    }
  },
  "required": [
    "instrument",
    "decision_time",
    "fill_time",
    "reference_price",
    "fill_price",
    "quantity",
    "fee",
    "slippage_cost"
  ],
  "title": "Fill",
  "type": "object"
}
