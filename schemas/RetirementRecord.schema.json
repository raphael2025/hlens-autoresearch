{
  "$defs": {
    "ExecutionMode": {
      "description": "ACTIVE 的属性，不是生命周期状态（ADR-0006 §2）。",
      "enum": [
        "SIMULATED",
        "LIVE"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "representation",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "对象引用：`{kind}:{name}@{version}`。",
      "properties": {
        "schema_version": {
          "default": "2.3.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "RETIRED 的追加式退役记录（07-validation.md §4.2）。RETIRED ≠ FAILED。\n\n`execution_mode` 复用共享的 `ExecutionMode` 枚举（`core/domain/execution.py`，\nADR-0011 D-17.5）：同一概念不再用自由字符串表达，也只有一个权威定义。",
  "properties": {
    "schema_version": {
      "default": "2.3.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_ref": {
      "$ref": "#/$defs/Ref"
    },
    "retirement_reason": {
      "minLength": 1,
      "title": "Retirement Reason",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "active_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active From"
    },
    "active_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active To"
    },
    "execution_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lessons": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lessons"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "subject_ref",
    "retirement_reason"
  ],
  "title": "RetirementRecord",
  "type": "object"
}
