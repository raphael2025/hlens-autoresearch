{
  "additionalProperties": false,
  "description": "实盘授权记录（ADR-0006 §2）。",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "authorized_by": {
      "minLength": 1,
      "title": "Authorized By",
      "type": "string"
    },
    "risk_budget": {
      "minLength": 1,
      "title": "Risk Budget",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    },
    "authorized_at": {
      "format": "date-time",
      "title": "Authorized At",
      "type": "string"
    }
  },
  "required": [
    "authorized_by",
    "risk_budget",
    "valid_until"
  ],
  "title": "AuthorizationRecord",
  "type": "object"
}
