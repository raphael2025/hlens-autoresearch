{
  "additionalProperties": false,
  "description": "封存样本外的开封记录（Constitution C-S2）；不可撤销。",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "unsealed_at": {
      "format": "date-time",
      "title": "Unsealed At",
      "type": "string"
    },
    "approved_by": {
      "minLength": 1,
      "title": "Approved By",
      "type": "string"
    },
    "family_unseal_count": {
      "exclusiveMinimum": 0,
      "title": "Family Unseal Count",
      "type": "integer"
    }
  },
  "required": [
    "unsealed_at",
    "approved_by",
    "family_unseal_count"
  ],
  "title": "OosUnsealing",
  "type": "object"
}
