{
  "additionalProperties": false,
  "description": "The limits a loop runs under (``LoopBudget.payload``); records bind its ``budget_hash``.",
  "properties": {
    "schema_version": {
      "default": "2.4.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "max_trials_per_round": {
      "minimum": 0,
      "title": "Max Trials Per Round",
      "type": "integer"
    },
    "max_trials_total": {
      "minimum": 0,
      "title": "Max Trials Total",
      "type": "integer"
    },
    "max_llm_cost_units": {
      "title": "Max Llm Cost Units",
      "type": "string"
    },
    "max_compute_seconds": {
      "title": "Max Compute Seconds",
      "type": "string"
    }
  },
  "required": [
    "max_trials_per_round",
    "max_trials_total",
    "max_llm_cost_units",
    "max_compute_seconds"
  ],
  "title": "LoopBudgetLimits",
  "type": "object"
}
