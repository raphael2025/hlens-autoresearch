{
  "$defs": {
    "PolicyBinding": {
      "additionalProperties": false,
      "description": "对一份版本化规则的绑定：`policy_id` + SemVer + 内容哈希（03-data.md §7.3）。\n\n`role` 区分 availability policy、precedence policy、PIT 选择规则与 parser 版本；使用处按字段\n要求确切的 `role`，因此 availability 与 precedence 绑定不能互相冒充。\n\n**诚实边界**：只约束形状。该版本是否已登记、`policy_hash` 是否等于该版本的真实内容、\npolicy 是否带有已审阅的来源证据，属未来 Registry（03-data.md §7.3「标识符冻结 ≠ 数据可信」）。",
      "properties": {
        "schema_version": {
          "default": "2.5.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PolicyRole"
        },
        "policy_id": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
          "title": "Policy Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        },
        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        }
      },
      "required": [
        "role",
        "policy_id",
        "version",
        "policy_hash"
      ],
      "title": "PolicyBinding",
      "type": "object"
    },
    "PolicyRole": {
      "description": "一条绑定所约束的规则类别；同一形状的绑定按类别分别使用、不可互换。",
      "enum": [
        "availability",
        "precedence",
        "point_in_time",
        "parser"
      ],
      "title": "PolicyRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "一条持久化的 supersedes 边：`revision_id` 取代 `superseded_revision_id`（ADR-0023 §4）。\n\n由 precedence policy 在 ingest 时产生，或事后追加以解决 competing heads；它只对\n`knowledge_cutoff >= knowledge_time` 的查询生效（ADR-0023 §5 第 4 步）。\n新旧 revision 不得相同；证据至少一项。\n\n**诚实边界**：证据是否真实、policy 是否真的证明了先后，属未来 Registry 与 policy 审阅。",
  "properties": {
    "schema_version": {
      "default": "2.5.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "observation_key": {
      "minLength": 1,
      "title": "Observation Key",
      "type": "string"
    },
    "revision_id": {
      "minLength": 1,
      "title": "Revision Id",
      "type": "string"
    },
    "superseded_revision_id": {
      "minLength": 1,
      "title": "Superseded Revision Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/PolicyBinding"
    },
    "evidence": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "knowledge_time": {
      "format": "date-time",
      "title": "Knowledge Time",
      "type": "string"
    }
  },
  "required": [
    "observation_key",
    "revision_id",
    "superseded_revision_id",
    "policy",
    "evidence",
    "knowledge_time"
  ],
  "title": "PrecedenceEvidence",
  "type": "object"
}
