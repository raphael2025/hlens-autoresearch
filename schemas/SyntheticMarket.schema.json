{
  "$defs": {
    "PlantedEffect": {
      "additionalProperties": false,
      "description": "一个植入的已知效应：`lag_minutes` 分钟前的收益以 `strength` 的比例进入当期收益。\n\n`strength` 为 0 等价于不植入；取值范围 (-1, 1) 保证过程平稳。",
      "properties": {
        "schema_version": {
          "default": "2.3.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "return_autocorrelation",
          "default": "return_autocorrelation",
          "title": "Kind",
          "type": "string"
        },
        "lag_minutes": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Lag Minutes",
          "type": "integer"
        },
        "strength": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Strength",
          "type": "string"
        }
      },
      "required": [
        "lag_minutes",
        "strength"
      ],
      "title": "PlantedEffect",
      "type": "object"
    },
    "SyntheticBar": {
      "additionalProperties": false,
      "description": "一根合成 1 分钟 bar（字段与 `canonical.bars_1m` 的市场内容一致）。",
      "properties": {
        "schema_version": {
          "default": "2.3.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "interval_start": {
          "format": "date-time",
          "title": "Interval Start",
          "type": "string"
        },
        "interval_end": {
          "format": "date-time",
          "title": "Interval End",
          "type": "string"
        },
        "open": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Open",
          "type": "string"
        },
        "high": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "High",
          "type": "string"
        },
        "low": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Low",
          "type": "string"
        },
        "close": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Close",
          "type": "string"
        },
        "volume": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Volume",
          "type": "string"
        },
        "trade_count": {
          "minimum": 0,
          "title": "Trade Count",
          "type": "integer"
        }
      },
      "required": [
        "interval_start",
        "interval_end",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "trade_count"
      ],
      "title": "SyntheticBar",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "生成结果：bar 按时间升序；`truth` 为实际植入的效应；`market_hash` 绑定规格与全部 bar。",
  "properties": {
    "schema_version": {
      "default": "2.3.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Spec Hash",
      "type": "string"
    },
    "provider": {
      "pattern": "^[a-z][a-z0-9_]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Provider",
      "type": "string"
    },
    "bars": {
      "items": {
        "$ref": "#/$defs/SyntheticBar"
      },
      "title": "Bars",
      "type": "array"
    },
    "truth": {
      "items": {
        "$ref": "#/$defs/PlantedEffect"
      },
      "title": "Truth",
      "type": "array"
    },
    "market_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Market Hash",
      "type": "string"
    }
  },
  "required": [
    "spec_hash",
    "provider",
    "bars",
    "truth",
    "market_hash"
  ],
  "title": "SyntheticMarket",
  "type": "object"
}
