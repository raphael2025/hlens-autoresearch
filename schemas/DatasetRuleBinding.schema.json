{
  "additionalProperties": false,
  "description": "v3 manifest 对 dataset 规则的绑定：`rule_id + SemVer + rule_hash`（ADR-0077 §1）。\n\n规则 spec 写明排序、chunk、leaf 与 fan-out 参数，它们随 `rule_hash` 进入 manifest 身份；\n改值即新规则版本。\n\n**诚实边界**：规则是否已登记、`rule_hash` 是否等于真实 spec，属 verifier 与未来 Registry。",
  "properties": {
    "schema_version": {
      "default": "2.4.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "rule_id": {
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "title": "Rule Id",
      "type": "string"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "rule_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rule Hash",
      "type": "string"
    }
  },
  "required": [
    "rule_id",
    "version",
    "rule_hash"
  ],
  "title": "DatasetRuleBinding",
  "type": "object"
}
