{
  "additionalProperties": false,
  "description": "一个选中 Canonical revision 的来源链：Canonical revision → Raw row revision → Raw source\npayload revision。\n\n第三跳是通用的来源 hop：首切片归档路径中 source 即归档文件 revision\n（`raw.binance_spot_archives`）；D3 REST 补尾的 Raw 响应载荷同样用这一跳表达（ADR-0022）。\n契约只表达 hop 的形状，具体 source 类型与其内容由未来 Collector / 表实现证明。\n\n表名为 Iceberg `namespace.table`：`canonical_table` 必须在 `canonical` namespace，`raw_table` 与\n`source_table` 必须在 `raw` namespace（03-data.md §7.1）。稳定身份为\n`(canonical_table, canonical_revision_id)`。",
  "properties": {
    "schema_version": {
      "default": "2.6.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "canonical_table": {
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "title": "Canonical Table",
      "type": "string"
    },
    "canonical_revision_id": {
      "minLength": 1,
      "title": "Canonical Revision Id",
      "type": "string"
    },
    "raw_table": {
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "title": "Raw Table",
      "type": "string"
    },
    "raw_revision_id": {
      "minLength": 1,
      "title": "Raw Revision Id",
      "type": "string"
    },
    "source_table": {
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "title": "Source Table",
      "type": "string"
    },
    "source_revision_id": {
      "minLength": 1,
      "title": "Source Revision Id",
      "type": "string"
    }
  },
  "required": [
    "canonical_table",
    "canonical_revision_id",
    "raw_table",
    "raw_revision_id",
    "source_table",
    "source_revision_id"
  ],
  "title": "SelectedRevisionLineage",
  "type": "object"
}
