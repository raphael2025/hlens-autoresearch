{
  "$defs": {
    "DatasetRef": {
      "additionalProperties": false,
      "description": "某个 Zone 的不可变数据快照引用（03-data.md §3）。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "zone": {
          "$ref": "#/$defs/Zone"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "time_range_start": {
          "format": "date-time",
          "title": "Time Range Start",
          "type": "string"
        },
        "time_range_end": {
          "format": "date-time",
          "title": "Time Range End",
          "type": "string"
        }
      },
      "required": [
        "zone",
        "table",
        "snapshot_id",
        "time_range_start",
        "time_range_end"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "representation",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "LlmCall": {
      "additionalProperties": false,
      "description": "LLM 调用记录：LLM 只产出数据，永不裁决（09-security.md §3）。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "output_hash": {
          "title": "Output Hash",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_hash",
        "input_hash",
        "output_hash"
      ],
      "title": "LlmCall",
      "type": "object"
    },
    "ProfileSelection": {
      "additionalProperties": false,
      "description": "实验实际使用的 Profile 选择依据（ADR-0009 §5）。\n\n必须同时给出**唯一的规则引用**、**该规则的内容哈希**与**选择输入**：\n只有规则版本不足以在事后重建\"当时按哪条规则、按什么输入选中了哪个 Profile\"。\n取消空默认值——缺绑定的实验不得进入 Validation。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_rule": {
          "$ref": "#/$defs/Ref"
        },
        "selection_rule_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Rule Hash",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/ProfileSelectionKey"
        }
      },
      "required": [
        "selection_rule",
        "selection_rule_hash",
        "key"
      ],
      "title": "ProfileSelection",
      "type": "object"
    },
    "ProfileSelectionKey": {
      "additionalProperties": false,
      "description": "选择输入：标的、周期、预登记的研究类别。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "venue": {
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        },
        "symbol": {
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "minLength": 1,
          "title": "Timeframe",
          "type": "string"
        },
        "research_class": {
          "minLength": 1,
          "title": "Research Class",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "symbol",
        "timeframe",
        "research_class"
      ],
      "title": "ProfileSelectionKey",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "对象引用：`{kind}:{name}@{version}`。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ReproducibilityTuple": {
      "additionalProperties": false,
      "description": "复现元组（06-experiment.md §2，冻结）。缺任一项则不得进入 Validation。\n\nADR-0009 §1：策略 / 风控 / Outcome 引用在元组**之内**，因此引用不同策略的实验\n不再得到相同的 `experiment_hash`。三个引用均**必须显式提供**，不适用时明确填 `null`，\n不以缺省掩盖遗漏。\n\nADR-0009 §2：实际 `seeds` 保留在元组与哈希内。相同完整规格（含相同 seeds）重复运行\n得到同一 `experiment_hash`（复现检查）；不同 seeds = 新的不可变规格变体 = 新哈希，\n族内关联由 `hypothesis_family_id` 与 trial 计数承担。**不引入**任何种子派生 DSL。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "hypothesis_ref": {
          "$ref": "#/$defs/Ref"
        },
        "strategy_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk_policy_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset_snapshots": {
          "items": {
            "$ref": "#/$defs/DatasetRef"
          },
          "minItems": 1,
          "title": "Dataset Snapshots",
          "type": "array"
        },
        "code_commit": {
          "minLength": 7,
          "title": "Code Commit",
          "type": "string"
        },
        "plugin_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Plugin Versions",
          "type": "object"
        },
        "dependency_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dependency Hashes",
          "type": "object"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "param_search_space": {
          "additionalProperties": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "array"
          },
          "title": "Param Search Space",
          "type": "object"
        },
        "seeds": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "array"
        },
        "environment_lock": {
          "minLength": 1,
          "title": "Environment Lock",
          "type": "string"
        },
        "constitution_version": {
          "minLength": 1,
          "title": "Constitution Version",
          "type": "string"
        },
        "validation_profile_version": {
          "minLength": 1,
          "title": "Validation Profile Version",
          "type": "string"
        },
        "validation_profile_hash": {
          "minLength": 1,
          "title": "Validation Profile Hash",
          "type": "string"
        },
        "profile_selection": {
          "$ref": "#/$defs/ProfileSelection"
        },
        "split_spec": {
          "minLength": 1,
          "title": "Split Spec",
          "type": "string"
        },
        "cost_model_ref": {
          "$ref": "#/$defs/Ref"
        },
        "llm_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LlmCall"
          },
          "title": "Llm Calls",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_ref",
        "strategy_ref",
        "risk_policy_ref",
        "outcome_ref",
        "dataset_snapshots",
        "code_commit",
        "dependency_hashes",
        "environment_lock",
        "constitution_version",
        "validation_profile_version",
        "validation_profile_hash",
        "profile_selection",
        "split_spec",
        "cost_model_ref"
      ],
      "title": "ReproducibilityTuple",
      "type": "object"
    },
    "RunState": {
      "description": "ExperimentRun 的执行状态机（06-experiment.md §5）。",
      "enum": [
        "REGISTERED",
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "ERRORED",
        "VALIDATING",
        "VALIDATED"
      ],
      "title": "RunState",
      "type": "string"
    },
    "Zone": {
      "description": "数据分层（03-data.md §3）。",
      "enum": [
        "raw",
        "canonical",
        "feature",
        "state",
        "event",
        "outcome",
        "research_dataset"
      ],
      "title": "Zone",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "ExperimentSpec 的一次执行。\n\n`run_id` 是**每次尝试唯一的不透明标识**，由 Runner 生成（ADR-0009 §3）：\n本契约**不冻结其生成算法**，也不把它定义为内容哈希。\n`run.repro.experiment_hash` 与所引用 Spec 的一致性校验属 Runner / Registry 义务\n（契约层拿不到 Spec 实例）。",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "experiment": {
      "$ref": "#/$defs/Ref"
    },
    "repro": {
      "$ref": "#/$defs/ReproducibilityTuple"
    },
    "state": {
      "$ref": "#/$defs/RunState",
      "default": "REGISTERED"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    }
  },
  "required": [
    "run_id",
    "experiment",
    "repro"
  ],
  "title": "ExperimentRun",
  "type": "object"
}
