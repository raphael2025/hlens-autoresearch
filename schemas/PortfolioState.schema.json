{
  "additionalProperties": false,
  "description": "风控看到的组合状态（`as_of` 时刻）。\n\n- `current_weights`：各标的当前（或上一次约束后的）权重；缺失即 0；\n- `equity`：已知时为组合权益（> 0）；在模拟之前运行风控时为 `None`——依赖路径的风控规则\n  （回撤、权益止损）必须在 `equity` 为 `None` 时以 `RiskInputError` fail closed。",
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "current_weights": {
      "additionalProperties": {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Current Weights",
      "type": "object"
    },
    "equity": {
      "anyOf": [
        {
          "gt": 0,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equity"
    }
  },
  "required": [
    "as_of"
  ],
  "title": "PortfolioState",
  "type": "object"
}
