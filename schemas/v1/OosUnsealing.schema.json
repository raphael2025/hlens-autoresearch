{
  "additionalProperties": false,
  "description": "封存样本外的开封记录（Constitution C-S2）；不可撤销。",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "unsealed_at": {
      "format": "date-time",
      "title": "Unsealed At",
      "type": "string"
    },
    "approved_by": {
      "minLength": 1,
      "title": "Approved By",
      "type": "string"
    },
    "family_unseal_count": {
      "exclusiveMinimum": 0,
      "title": "Family Unseal Count",
      "type": "integer"
    }
  },
  "required": [
    "unsealed_at",
    "approved_by",
    "family_unseal_count"
  ],
  "title": "OosUnsealing",
  "type": "object"
}
