{
  "$defs": {
    "Zone": {
      "description": "数据分层（03-data.md §3）。",
      "enum": [
        "raw",
        "canonical",
        "feature",
        "state",
        "event",
        "outcome",
        "research_dataset"
      ],
      "title": "Zone",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "某个 Zone 的不可变数据快照引用（03-data.md §3）。",
  "properties": {
    "schema_version": {
      "default": "2.4.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "zone": {
      "$ref": "#/$defs/Zone"
    },
    "table": {
      "title": "Table",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "time_range_start": {
      "format": "date-time",
      "title": "Time Range Start",
      "type": "string"
    },
    "time_range_end": {
      "format": "date-time",
      "title": "Time Range End",
      "type": "string"
    }
  },
  "required": [
    "zone",
    "table",
    "snapshot_id",
    "time_range_start",
    "time_range_end"
  ],
  "title": "DatasetRef",
  "type": "object"
}
