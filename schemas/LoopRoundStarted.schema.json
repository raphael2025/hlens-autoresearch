{
  "additionalProperties": false,
  "description": "A ``loop_round_started`` journal line: a round is about to spend budget.",
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "loop_id": {
      "title": "Loop Id",
      "type": "string"
    },
    "round_index": {
      "minimum": 0,
      "title": "Round Index",
      "type": "integer"
    },
    "previous_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Hash"
    }
  },
  "required": [
    "loop_id",
    "round_index",
    "previous_hash"
  ],
  "title": "LoopRoundStarted",
  "type": "object"
}
