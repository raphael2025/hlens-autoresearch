{
  "$defs": {
    "ConditionedStrategy": {
      "additionalProperties": false,
      "description": "门控组合：状态 `state` 等于 `state_value` 时持有 `base` 的目标仓位，否则空仓。\n\n未知或缺失的状态视为空仓；每个 (base, state, state_value) 计一个 trial（ADR-0088 决策 2）。",
      "properties": {
        "schema_version": {
          "default": "2.5.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "const": "conditioned",
          "default": "conditioned",
          "title": "Type",
          "type": "string"
        },
        "base": {
          "$ref": "#/$defs/Ref"
        },
        "state": {
          "$ref": "#/$defs/Ref"
        },
        "state_value": {
          "minLength": 1,
          "title": "State Value",
          "type": "string"
        }
      },
      "required": [
        "base",
        "state",
        "state_value"
      ],
      "title": "ConditionedStrategy",
      "type": "object"
    },
    "EnsembleStrategy": {
      "additionalProperties": false,
      "description": "等权组合：各成员目标仓位的等权平均（`rule=\"equal_weight_mean\"`）。\n\n成员至少 2 个、不得重复（按目标身份）；风险政策与适用标的一致由 Registry 核对（ADR-0069）。",
      "properties": {
        "schema_version": {
          "default": "2.5.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "const": "ensemble",
          "default": "ensemble",
          "title": "Type",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "minItems": 2,
          "title": "Members",
          "type": "array"
        },
        "rule": {
          "const": "equal_weight_mean",
          "default": "equal_weight_mean",
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "members"
      ],
      "title": "EnsembleStrategy",
      "type": "object"
    },
    "Instrument": {
      "additionalProperties": false,
      "description": "可交易标的。跨 venue 的符号必须规范化映射。",
      "properties": {
        "schema_version": {
          "default": "2.5.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "instrument_type": {
          "$ref": "#/$defs/InstrumentType"
        },
        "base": {
          "title": "Base",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "symbol",
        "instrument_type",
        "base",
        "quote"
      ],
      "title": "Instrument",
      "type": "object"
    },
    "InstrumentType": {
      "enum": [
        "spot",
        "perpetual",
        "future",
        "option"
      ],
      "title": "InstrumentType",
      "type": "string"
    },
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "representation",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "NegatedStrategy": {
      "additionalProperties": false,
      "description": "取反组合：`base` 的目标仓位取反。\n\n**不**作为验证负对照（负对照由验证层定义）；现货下的执行受做空成本缺口（ST-4）限制，\n由 Provider fail closed（ADR-0088 决策 2）。",
      "properties": {
        "schema_version": {
          "default": "2.5.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "const": "negated",
          "default": "negated",
          "title": "Type",
          "type": "string"
        },
        "base": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "base"
      ],
      "title": "NegatedStrategy",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "对象引用：`{kind}:{name}@{version}`。",
      "properties": {
        "schema_version": {
          "default": "2.5.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "信号 → 目标仓位的声明式规格。\n\n参数空间必须声明，用于多重检验的尝试次数计算（Constitution C-T1）。",
  "properties": {
    "schema_version": {
      "default": "2.5.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "strategy",
      "default": "strategy",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Lineage",
      "type": "array"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "minItems": 1,
      "title": "Signals",
      "type": "array"
    },
    "params": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Params",
      "type": "object"
    },
    "param_search_space": {
      "additionalProperties": {
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "type": "array"
      },
      "title": "Param Search Space",
      "type": "object"
    },
    "risk_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "applicable_instruments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Instrument"
      },
      "title": "Applicable Instruments",
      "type": "array"
    },
    "composition": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "conditioned": "#/$defs/ConditionedStrategy",
              "ensemble": "#/$defs/EnsembleStrategy",
              "negated": "#/$defs/NegatedStrategy"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ConditionedStrategy"
            },
            {
              "$ref": "#/$defs/EnsembleStrategy"
            },
            {
              "$ref": "#/$defs/NegatedStrategy"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Composition"
    }
  },
  "required": [
    "name",
    "version",
    "signals"
  ],
  "title": "StrategySpec",
  "type": "object"
}
