{
  "$defs": {
    "LifecycleState": {
      "enum": [
        "IDEA",
        "CANDIDATE",
        "VALIDATION",
        "OOS",
        "PAPER",
        "PRODUCTION_CANDIDATE",
        "ACTIVE",
        "DEGRADED",
        "REVALIDATION",
        "RETIRED",
        "REJECTED",
        "FAILED"
      ],
      "title": "LifecycleState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A lifecycle transition the loop's guard made (no approval; at the round's ``as_of``).",
  "properties": {
    "schema_version": {
      "default": "2.2.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "from": {
      "$ref": "#/$defs/LifecycleState"
    },
    "to": {
      "$ref": "#/$defs/LifecycleState"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "triggered_by": {
      "title": "Triggered By",
      "type": "string"
    }
  },
  "required": [
    "subject",
    "from",
    "to",
    "reason",
    "evidence",
    "triggered_by"
  ],
  "title": "LoopTransitionRecord",
  "type": "object"
}
