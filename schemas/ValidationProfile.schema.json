        },
        "min_neighborhood_performance_ratio": {
          "title": "Min Neighborhood Performance Ratio",
          "type": "number"
        },
        "min_positive_neighbor_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Positive Neighbor Fraction",
