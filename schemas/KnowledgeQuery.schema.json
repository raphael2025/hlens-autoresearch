{
  "$defs": {
    "EvidenceLevel": {
      "description": "知识条目的证据等级（docs/research/knowledge-base.md）。",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "KnowledgeStatus": {
      "enum": [
        "unverified",
        "supported",
        "contradicted",
        "inconclusive"
      ],
      "title": "KnowledgeStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "一次知识检索。\n\n- `terms`：全部须出现在条目 `name` / `claim` / `conditions` 中（不区分大小写，AND 语义）；\n- `name_prefix`：库前缀，如 `strategy_`、`factor_`、`state_`（空 = 不限）；\n- `evidence_at_least`：只返回证据等级不低于该值的条目（空 = 不限）；\n- `statuses`：只返回这些状态（空 = 不限）；\n- `limit`：结果上限。",
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "terms": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Terms",
      "type": "array"
    },
    "name_prefix": {
      "default": "",
      "title": "Name Prefix",
      "type": "string"
    },
    "evidence_at_least": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceLevel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "statuses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KnowledgeStatus"
      },
      "title": "Statuses",
      "type": "array"
    },
    "limit": {
      "default": 50,
      "maximum": 1000,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    }
  },
  "title": "KnowledgeQuery",
  "type": "object"
}
