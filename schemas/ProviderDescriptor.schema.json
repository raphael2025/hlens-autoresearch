{
  "additionalProperties": false,
  "description": "FeatureProvider 的身份与能力声明（05-plugin.md §1 / §3：FeatureProvider 必须确定性）。\n\n`supported_features`：非空，`feature:name@semver` → 该 `FeatureSpec` 的内容哈希。规格的参数\n（窗口长度等）属于规格内容，因而由哈希绑定。实例生命周期内不变。",
  "properties": {
    "schema_version": {
      "default": "2.6.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "deterministic": {
      "const": true,
      "title": "Deterministic",
      "type": "boolean"
    },
    "supported_features": {
      "additionalProperties": false,
      "patternProperties": {
        "^feature:[a-z][a-z0-9_]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "title": "Supported Features",
      "type": "object"
    }
  },
  "required": [
    "name",
    "version",
    "deterministic",
    "supported_features"
  ],
  "title": "ProviderDescriptor",
  "type": "object"
}
