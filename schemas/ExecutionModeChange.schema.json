{
  "$defs": {
    "AuthorizationRecord": {
      "additionalProperties": false,
      "description": "实盘授权记录（ADR-0006 §2）。\n\n`subject` 绑定被授权对象，授权窗口必须为正（ADR-0011 D-17.3）。\n`authorized_by` **是否真的有权批准**由未来的授权服务核验，契约层只校验证据结构。",
      "properties": {
        "schema_version": {
          "default": "2.6.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/Ref"
        },
        "authorized_by": {
          "minLength": 1,
          "title": "Authorized By",
          "type": "string"
        },
        "risk_budget": {
          "minLength": 1,
          "title": "Risk Budget",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "authorized_at": {
          "format": "date-time",
          "title": "Authorized At",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "authorized_by",
        "risk_budget",
        "valid_until"
      ],
      "title": "AuthorizationRecord",
      "type": "object"
    },
    "ExecutionMode": {
      "description": "ACTIVE 的属性，不是生命周期状态（ADR-0006 §2）。",
      "enum": [
        "SIMULATED",
        "LIVE"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "representation",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "IDEA",
        "CANDIDATE",
        "VALIDATION",
        "OOS",
        "PAPER",
        "PRODUCTION_CANDIDATE",
        "ACTIVE",
        "DEGRADED",
        "REVALIDATION",
        "RETIRED",
        "REJECTED",
        "FAILED"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "对象引用：`{kind}:{name}@{version}`。",
      "properties": {
        "schema_version": {
          "default": "2.6.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    },
    "RiskGateRecord": {
      "additionalProperties": false,
      "description": "实盘前的独立 Risk Gate 检查（与 RiskProvider 分离）。\n\n`subject` 绑定被检查的对象（ADR-0011 D-17.3）：属于另一个对象的检查不得被挂到\n一次 `ExecutionModeChange` 上。检查**内容**与风险预算单位不在契约层定义。",
      "properties": {
        "schema_version": {
          "default": "2.6.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/Ref"
        },
        "gate_id": {
          "minLength": 1,
          "title": "Gate Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "limits": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Limits",
          "type": "object"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "gate_id",
        "passed"
      ],
      "title": "RiskGateRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`execution_mode` 变更的独立审计事件。\n\n切到 LIVE 需要：对象处于 ACTIVE、通过独立 Risk Gate、有授权记录，且两份证据都属于\n本次变更的 `subject`、授权覆盖变更时刻、Risk Gate 不晚于变更（ADR-0011 D-17.3）。\n\n**诚实边界**（ADR-0011 D-17.4）：契约层只校验可核验的**证据结构**，\n**不再**拒绝 `to_mode = LIVE`。\"Phase 13 之前禁止真实生产交易\"\n（ADR-0006 §3 第 5 条、CLAUDE.md H10）依然有效，但它的执行点在未来 Control Plane 的\n可信配置与授权服务以及人类授权，不在这个 DTO —— 一个载荷无法自证自己的运行环境。\n被删除的 `live_execution_enabled` 是自报字段，从未提供过真实防护。",
  "properties": {
    "schema_version": {
      "default": "2.6.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Ref"
    },
    "state": {
      "$ref": "#/$defs/LifecycleState"
    },
    "from_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "to_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "risk_gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/RiskGateRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authorization": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    }
  },
  "required": [
    "subject",
    "state",
    "from_mode",
    "to_mode"
  ],
  "title": "ExecutionModeChange",
  "type": "object"
}
