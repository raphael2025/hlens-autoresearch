{
  "$defs": {
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "representation",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "OutcomeEvent": {
      "additionalProperties": false,
      "description": "一个需要标签的事件：`event_time` 是决策时刻（信号可被观察的时刻）。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "event_key": {
          "minLength": 1,
          "title": "Event Key",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        }
      },
      "required": [
        "event_key",
        "event_time"
      ],
      "title": "OutcomeEvent",
      "type": "object"
    },
    "OutcomeLabelSpec": {
      "additionalProperties": false,
      "description": "一份 `OutcomeSpec` 的可执行标签参数。\n\n- `forward_return`：`exit_close / entry_open - 1`，两个屏障必须为空；\n- `triple_barrier`：上屏障 `entry * (1 + upper_barrier)`、下屏障 `entry * (1 - lower_barrier)`，\n  垂直屏障 = horizon；两个屏障必须给出，`lower_barrier < 1`。\n\n屏障与 horizon 是**标签定义参数**，不是验证阈值。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Ref"
        },
        "outcome_spec_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outcome Spec Hash",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/OutcomeMethod"
        },
        "horizon": {
          "format": "duration",
          "title": "Horizon",
          "type": "string"
        },
        "upper_barrier": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Barrier"
        },
        "lower_barrier": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Barrier"
        }
      },
      "required": [
        "outcome",
        "outcome_spec_hash",
        "method",
        "horizon"
      ],
      "title": "OutcomeLabelSpec",
      "type": "object"
    },
    "OutcomeMethod": {
      "description": "首批标签方法（ADR-0037 §2）。",
      "enum": [
        "forward_return",
        "triple_barrier"
      ],
      "title": "OutcomeMethod",
      "type": "string"
    },
    "OutcomePriceBar": {
      "additionalProperties": false,
      "description": "一根 Canonical 价格 bar：区间 `[interval_start, interval_end)`，区间结束后才可用。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "interval_start": {
          "format": "date-time",
          "title": "Interval Start",
          "type": "string"
        },
        "interval_end": {
          "format": "date-time",
          "title": "Interval End",
          "type": "string"
        },
        "available_time": {
          "format": "date-time",
          "title": "Available Time",
          "type": "string"
        },
        "open": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Open",
          "type": "string"
        },
        "high": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "High",
          "type": "string"
        },
        "low": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Low",
          "type": "string"
        },
        "close": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Close",
          "type": "string"
        }
      },
      "required": [
        "interval_start",
        "interval_end",
        "available_time",
        "open",
        "high",
        "low",
        "close"
      ],
      "title": "OutcomePriceBar",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "对象引用：`{kind}:{name}@{version}`。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "一次标签计算请求（单一标的）。\n\n- `events`：非空，按 `(event_time, event_key)` 规范排序；`event_key` 唯一；\n- `bars`：按 `interval_start` 严格升序且互不重叠；每根 `available_time <= price_cutoff`；\n- 同一请求内容 → 同一 `content_hash()`（事件输入顺序不影响）。",
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "label_spec": {
      "$ref": "#/$defs/OutcomeLabelSpec"
    },
    "manifest_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Content Hash",
      "type": "string"
    },
    "price_cutoff": {
      "format": "date-time",
      "title": "Price Cutoff",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/OutcomeEvent"
      },
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "bars": {
      "items": {
        "$ref": "#/$defs/OutcomePriceBar"
      },
      "title": "Bars",
      "type": "array"
    }
  },
  "required": [
    "label_spec",
    "manifest_content_hash",
    "price_cutoff",
    "events",
    "bars"
  ],
  "title": "OutcomeRequest",
  "type": "object"
}
