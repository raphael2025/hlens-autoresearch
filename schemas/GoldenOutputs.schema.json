{
  "additionalProperties": false,
  "description": "固定数据快照上的参考信号 / 仓位序列，用于 Equivalence Gate。\n\n两个 `*_hash` 是被引用内容的 `ContentHash`（ADR-0015 §D-21.1）；\n`dataset_snapshot_id` 与两个 `*_uri` **不**收紧：前者的格式由外部系统（Iceberg）决定，\n后者取决于尚未决定的存储方案（D-01、D-02），按名字里有 `id` / `uri` 就套哈希类型\n只会得到错误的契约（ADR-0015 §D-21.3）。",
  "properties": {
    "schema_version": {
      "default": "2.3.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_snapshot_id": {
      "minLength": 1,
      "title": "Dataset Snapshot Id",
      "type": "string"
    },
    "signals_uri": {
      "minLength": 1,
      "title": "Signals Uri",
      "type": "string"
    },
    "signals_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Signals Hash",
      "type": "string"
    },
    "positions_uri": {
      "minLength": 1,
      "title": "Positions Uri",
      "type": "string"
    },
    "positions_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Positions Hash",
      "type": "string"
    }
  },
  "required": [
    "dataset_snapshot_id",
    "signals_uri",
    "signals_hash",
    "positions_uri",
    "positions_hash"
  ],
  "title": "GoldenOutputs",
  "type": "object"
}
