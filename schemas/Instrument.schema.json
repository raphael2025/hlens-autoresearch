{
  "$defs": {
    "InstrumentType": {
      "enum": [
        "spot",
        "perpetual",
        "future",
        "option"
      ],
      "title": "InstrumentType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "可交易标的。跨 venue 的符号必须规范化映射。",
  "properties": {
    "schema_version": {
      "default": "2.6.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "venue": {
      "title": "Venue",
      "type": "string"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "instrument_type": {
      "$ref": "#/$defs/InstrumentType"
    },
    "base": {
      "title": "Base",
      "type": "string"
    },
    "quote": {
      "title": "Quote",
      "type": "string"
    }
  },
  "required": [
    "venue",
    "symbol",
    "instrument_type",
    "base",
    "quote"
  ],
  "title": "Instrument",
  "type": "object"
}
