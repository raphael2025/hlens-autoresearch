{
  "$defs": {
    "SourceBinding": {
      "additionalProperties": false,
      "description": "版本化来源绑定：`source_id` + SemVer（标识符格式与 03-data.md §7.3 一致）。",
      "properties": {
        "schema_version": {
          "default": "2.4.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version"
      ],
      "title": "SourceBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "一次有界、可重放的获取请求。\n\n`request_id` 是调用方给出的稳定身份；`symbols` 非空、去重、规范排序；覆盖区间为 UTC 半开区间。",
  "properties": {
    "schema_version": {
      "default": "2.4.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:=@+-]{0,255}$",
      "title": "Request Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceBinding"
    },
    "data_type": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Data Type",
      "type": "string"
    },
    "symbols": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Symbols",
      "type": "array",
      "uniqueItems": true
    },
    "coverage_start": {
      "format": "date-time",
      "title": "Coverage Start",
      "type": "string"
    },
    "coverage_end": {
      "format": "date-time",
      "title": "Coverage End",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "source",
    "data_type",
    "symbols",
    "coverage_start",
    "coverage_end"
  ],
  "title": "CollectionRequest",
  "type": "object"
}
