{
  "$defs": {
    "ConstrainedPosition": {
      "additionalProperties": false,
      "description": "一个标的约束后的仓位。\n\n- `binding_rules`：实际改变了仓位的规则名（`RiskPolicy.rules` 的机读名），唯一升序；为空当且仅当\n  `constrained_weight == requested_weight`（任何调整都必须有名可查）；\n- `inputs_used` / `latest_input_available_time`：风控侧（信号）实际使用的观察。",
      "properties": {
        "schema_version": {
          "default": "2.6.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "instrument": {
          "minLength": 1,
          "title": "Instrument",
          "type": "string"
        },
        "requested_weight": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Requested Weight",
          "type": "string"
        },
        "constrained_weight": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Constrained Weight",
          "type": "string"
        },
        "binding_rules": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Binding Rules",
          "type": "array"
        },
        "inputs_used": {
          "minimum": 0,
          "title": "Inputs Used",
          "type": "integer"
        },
        "latest_input_available_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Input Available Time"
        }
      },
      "required": [
        "instrument",
        "requested_weight",
        "constrained_weight",
        "inputs_used"
      ],
      "title": "ConstrainedPosition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "一次 `constrain` 的结果：`positions` 按 `instrument` 唯一升序，`result_hash` 构造时复核。",
  "properties": {
    "schema_version": {
      "default": "2.6.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "provider": {
      "pattern": "^[a-z][a-z0-9_]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Provider",
      "type": "string"
    },
    "provider_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Hash",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "positions": {
      "items": {
        "$ref": "#/$defs/ConstrainedPosition"
      },
      "minItems": 1,
      "title": "Positions",
      "type": "array"
    },
    "result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Hash",
      "type": "string"
    }
  },
  "required": [
    "request_hash",
    "provider",
    "provider_hash",
    "decision_time",
    "positions",
    "result_hash"
  ],
  "title": "RiskResult",
  "type": "object"
}
