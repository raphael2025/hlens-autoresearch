{
  "$defs": {
    "BenchmarkParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-T4：空模型为主，市场基准按类别适用。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "null_model": {
          "minLength": 1,
          "title": "Null Model",
          "type": "string"
        },
        "null_model_simulations": {
          "exclusiveMinimum": 0,
          "title": "Null Model Simulations",
          "type": "integer"
        },
        "null_model_percentile": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Null Model Percentile",
          "type": "number"
        },
        "market_benchmark_rule": {
          "minLength": 1,
          "title": "Market Benchmark Rule",
          "type": "string"
        },
        "inverse_control_reported": {
          "title": "Inverse Control Reported",
          "type": "boolean"
        },
        "null_model_percentile_exact": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Null Model Percentile Exact"
        }
      },
      "required": [
        "null_model",
        "null_model_simulations",
        "null_model_percentile",
        "market_benchmark_rule",
        "inverse_control_reported"
      ],
      "title": "BenchmarkParams",
      "type": "object"
    },
    "CapacityParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-R5：容量与冲击（ADR-0052 §2；只有字段与结构范围，没有数值）。\n\n每个字段可选（缺失的项由 G4 按 ADR-0041 §1 处理：`param:` 或 `INCONCLUSIVE`），但给出\n`capacity` 就至少给一项——空块不是配置。`impact_model` 必须是研究代码已实现的方法名\n（运行时由 G4 拒绝未实现的方法；契约层只约束非空）。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "min_capacity": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Capacity"
        },
        "max_participation_rate": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Participation Rate"
        },
        "impact_coefficient": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impact Coefficient"
        },
        "impact_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impact Model"
        }
      },
      "title": "CapacityParams",
      "type": "object"
    },
    "CostStressParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-R4 与 A6。\n\n结构不变量（ADR-0014 §D-20.4）：两个倍数序列的**每一项**严格为正；\n`cost_model` 必须指向 `cost_model` kind——这是跨字段语义，JSON Schema 不表达它，\n由运行时校验保证。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "cost_model": {
          "$ref": "#/$defs/Ref"
        },
        "fill_assumption": {
          "minLength": 1,
          "title": "Fill Assumption",
          "type": "string"
        },
        "stress_multipliers": {
          "items": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Stress Multipliers",
          "type": "array"
        },
        "reported_only_multipliers": {
          "default": [],
          "items": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "title": "Reported Only Multipliers",
          "type": "array"
        },
        "delay_stress_bars": {
          "minimum": 0,
          "title": "Delay Stress Bars",
          "type": "integer"
        },
        "min_breakeven_cost_multiple": {
          "exclusiveMinimum": 0.0,
          "title": "Min Breakeven Cost Multiple",
          "type": "number"
        },
        "stress_multipliers_exact": {
          "anyOf": [
            {
              "items": {
                "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stress Multipliers Exact"
        },
        "reported_only_multipliers_exact": {
          "anyOf": [
            {
              "items": {
                "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Only Multipliers Exact"
        },
        "min_breakeven_cost_multiple_exact": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Breakeven Cost Multiple Exact"
        }
      },
      "required": [
        "cost_model",
        "fill_assumption",
        "stress_multipliers",
        "delay_stress_bars",
        "min_breakeven_cost_multiple"
      ],
      "title": "CostStressParams",
      "type": "object"
    },
    "CrossAssetParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-R3：声明范围内跨资产一致性（ADR-0052 §2）。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "min_positive_fraction": {
          "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
          "title": "Min Positive Fraction",
          "type": "string"
        }
      },
      "required": [
        "min_positive_fraction"
      ],
      "title": "CrossAssetParams",
      "type": "object"
    },
    "DataSplitParams": {
      "additionalProperties": false,
      "description": "对应 Constitution 第四章。封存区使用固定日期边界，不随运行时间滚动。\n\n结构不变量（ADR-0014 §D-20.4）：`sealed_oos_length > 0`（零长度封存区不构成样本外检验）；\n`embargo >= 0` 与 `sealed_oos_max_extension >= 0`（零分别表示不设隔离期、不允许延长）。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "research_window_start": {
          "format": "date",
          "title": "Research Window Start",
          "type": "string"
        },
        "sealed_oos_boundary": {
          "format": "date",
          "title": "Sealed Oos Boundary",
          "type": "string"
        },
        "sealed_oos_length": {
          "format": "duration",
          "title": "Sealed Oos Length",
          "type": "string"
        },
        "sealed_oos_max_extension": {
          "format": "duration",
          "title": "Sealed Oos Max Extension",
          "type": "string"
        },
        "embargo": {
          "format": "duration",
          "title": "Embargo",
          "type": "string"
        },
        "walk_forward": {
          "$ref": "#/$defs/WalkForwardParams"
        },
        "sealed_oos_max_unsealings": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sealed Oos Max Unsealings"
        }
      },
      "required": [
        "research_window_start",
        "sealed_oos_boundary",
        "sealed_oos_length",
        "sealed_oos_max_extension",
        "embargo",
        "walk_forward"
      ],
      "title": "DataSplitParams",
      "type": "object"
    },
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "representation",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "LifecycleParams": {
      "additionalProperties": false,
      "description": "对应 Constitution C-G3 与 ADR-0006（Q-6 仍开放）。\n\n结构不变量（ADR-0014 §D-20.4）：`paper_period > 0`——观察期必须有长度。\n本约束只管符号，不回答\"观察期该多长\"（Phase 4）或\"该由谁定义\"（Q-6）。",
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "paper_period": {
          "format": "duration",
          "title": "Paper Period",
          "type": "string"
        },
        "paper_acceptance_rule": {
          "minLength": 1,
          "title": "Paper Acceptance Rule",
          "type": "string"
        },
        "degradation_thresholds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Degradation Thresholds",
          "type": "object"
        },
        "degradation_thresholds_exact": {
          "anyOf": [
            {
              "additionalProperties": {
                "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degradation Thresholds Exact"
        }
      },
      "required": [
        "paper_period",
        "paper_acceptance_rule"
      ],
      "title": "LifecycleParams",
      "type": "object"
    },
    "ParameterStabilityParams": {
