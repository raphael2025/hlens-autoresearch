{
  "$defs": {
    "GateResult": {
      "additionalProperties": false,
      "description": "单个验证门的结构化结果（07-validation.md §2）。\n\n`threshold_source` 指向 Validation Profile 中的字段路径：阈值不得写死在流水线里。\n\n精确表示（ADR-0052 §1，D-FLOAT）：可选的 `value_exact` / `threshold_exact`。存在时浮点字段\n必须恰为 `float(精确值)`（否则拒绝），哈希载荷排除对应浮点字段，判定由产生方用精确值比较；\n不存在时省略出载荷，旧载荷哈希逐位不变。一个带阈值的门要么两者都精确、要么都不精确\n（混合表示的比较不可复核，拒绝）。浮点字段弃用，保留到下一次因其他原因发生的 major。",
      "properties": {
        "schema_version": {
          "default": "2.2.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "gate_id": {
          "minLength": 1,
          "title": "Gate Id",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "threshold_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Source"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "value_exact": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Exact"
        },
        "threshold_exact": {
          "anyOf": [
            {
              "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Exact"
        }
      },
      "required": [
        "gate_id",
        "metric",
        "value",
        "verdict"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "Kind": {
      "description": "可版本化对象的类型（02-domain.md §1）。",
      "enum": [
        "dataset",
        "representation",
        "feature",
        "state",
        "event",
        "outcome",
        "strategy",
        "risk",
        "cost_model",
        "experiment",
        "hypothesis",
        "knowledge",
        "artifact",
        "profile",
        "profile_selection_rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "对象引用：`{kind}:{name}@{version}`。",
      "properties": {
        "schema_version": {
          "default": "2.2.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "按 Constitution + Validation Profile 执行的判定结果。\n\n`run_id` 与 `experiment_hash` 同时存在，形成 spec ↔ run ↔ report 的可核验链\n（ADR-0009 §5）。`report_id` 是外部赋予的标识，**不是**结果内容身份；\n结果内容身份应由未来内容寻址的结果 manifest 提供，不在本轮实现（ADR-0009 §4）。\n`run_id` 与 `report_id` 都**没有**被排除出内容哈希。",
  "properties": {
    "schema_version": {
      "default": "2.2.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Ref"
    },
    "experiment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Experiment Hash",
      "type": "string"
    },
    "constitution_version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Constitution Version",
      "type": "string"
    },
    "validation_profile": {
      "$ref": "#/$defs/Ref"
    },
    "validation_profile_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Profile Hash",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "minItems": 1,
      "title": "Gates",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "run_id",
    "subject",
    "experiment_hash",
    "constitution_version",
    "validation_profile",
    "validation_profile_hash",
    "gates",
    "verdict"
  ],
  "title": "ValidationReport",
  "type": "object"
}
