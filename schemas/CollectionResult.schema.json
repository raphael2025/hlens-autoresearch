{
  "$defs": {
    "CollectedObject": {
      "additionalProperties": false,
      "description": "一个已发布对象及其最小来源证据。\n\n- `ref`：经 `StorageAdapter` 发布的不可变对象引用；\n- `symbol` 与 UTC 半开区间 `[coverage_start, coverage_end)`：该对象覆盖的范围；\n- `source_uri`、`retrieved_at`：从哪里、何时取得（`retrieved_at` 属知识轴证据，\n  不是 `available_time`）；\n- `source_sha256`：来源声明的校验和；给出时必须等于 `ref.sha256`；\n- `source_metadata`：原样保留的来源元数据（例如 HTTP `etag`），键为小写 token，\n  凭据形状的键被拒绝。",
      "properties": {
        "schema_version": {
          "default": "2.4.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "symbol": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Symbol",
          "type": "string"
        },
        "coverage_start": {
          "format": "date-time",
          "title": "Coverage Start",
          "type": "string"
        },
        "coverage_end": {
          "format": "date-time",
          "title": "Coverage End",
          "type": "string"
        },
        "source_uri": {
          "pattern": "^(?:https://[a-z0-9.-]+(?::[0-9]{1,5})?(?:[/?][!-~]*)?|file:///[!-~]+)$",
          "title": "Source Uri",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_metadata": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]{0,127}$": {
              "type": "string"
            }
          },
          "title": "Source Metadata",
          "type": "object"
        }
      },
      "required": [
        "ref",
        "symbol",
        "coverage_start",
        "coverage_end",
        "source_uri",
        "retrieved_at"
      ],
      "title": "CollectedObject",
      "type": "object"
    },
    "CollectionRequest": {
      "additionalProperties": false,
      "description": "一次有界、可重放的获取请求。\n\n`request_id` 是调用方给出的稳定身份；`symbols` 非空、去重、规范排序；覆盖区间为 UTC 半开区间。",
      "properties": {
        "schema_version": {
          "default": "2.4.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:=@+-]{0,255}$",
          "title": "Request Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceBinding"
        },
        "data_type": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Data Type",
          "type": "string"
        },
        "symbols": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Symbols",
          "type": "array",
          "uniqueItems": true
        },
        "coverage_start": {
          "format": "date-time",
          "title": "Coverage Start",
          "type": "string"
        },
        "coverage_end": {
          "format": "date-time",
          "title": "Coverage End",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "source",
        "data_type",
        "symbols",
        "coverage_start",
        "coverage_end"
      ],
      "title": "CollectionRequest",
      "type": "object"
    },
    "CoverageGap": {
      "additionalProperties": false,
      "description": "某个 symbol 在 UTC 半开区间内没有获取到对象的显式记录；`detail` 为非空证据描述。",
      "properties": {
        "schema_version": {
          "default": "2.4.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Symbol",
          "type": "string"
        },
        "coverage_start": {
          "format": "date-time",
          "title": "Coverage Start",
          "type": "string"
        },
        "coverage_end": {
          "format": "date-time",
          "title": "Coverage End",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/GapReason"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "coverage_start",
        "coverage_end",
        "reason",
        "detail"
      ],
      "title": "CoverageGap",
      "type": "object"
    },
    "GapReason": {
      "description": "显式缺口的原因。",
      "enum": [
        "source_absent"
      ],
      "title": "GapReason",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "description": "已发布不可变对象的引用：逻辑 key + 持久 URI + SHA-256 + 字节数。\n\nURI 由实现生成（ADR-0021：业务代码不拼接绝对路径）。`ContentBlobRef` 仍是通用内容引用；\n本类型额外要求 key 与长度，供 Raw 记录与 `open_read` 核对。",
      "properties": {
        "schema_version": {
          "default": "2.4.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "key": {
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,254}(?:/[A-Za-z0-9][A-Za-z0-9._=-]{0,254})*$",
          "title": "Key",
          "type": "string"
        },
        "uri": {
          "pattern": "^(?:file:///|[a-z][a-z0-9+.-]*://[a-z0-9.-]+(?::[0-9]{1,5})?/)[!-~]+$",
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "uri",
        "sha256",
        "size"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "SourceBinding": {
      "additionalProperties": false,
      "description": "版本化来源绑定：`source_id` + SemVer（标识符格式与 03-data.md §7.3 一致）。",
      "properties": {
        "schema_version": {
          "default": "2.4.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version"
      ],
      "title": "SourceBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "一次 `collect` 的结果：原请求 + collector 身份 + 对象 + 显式缺口。\n\n`objects` 与 `gaps` 必须显式给出（可为空）。不变量：\n\n- `objects` 按 `ref.key` 规范排序且 key 唯一；`gaps` 按 `(symbol, coverage_start)` 规范排序；\n- 每个对象 / 缺口的 symbol 属于请求，区间落在请求区间内；\n- 对每个 symbol：缺口之间、缺口与对象之间不重叠，对象与缺口的并集恰好等于请求区间\n  （同一 symbol 的多个对象可以覆盖同一区间，例如归档与其校验和文件）。",
  "properties": {
    "schema_version": {
      "default": "2.4.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/CollectionRequest"
    },
    "collector_id": {
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "title": "Collector Id",
      "type": "string"
    },
    "collector_version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Collector Version",
      "type": "string"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/CollectedObject"
      },
      "title": "Objects",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/CoverageGap"
      },
      "title": "Gaps",
      "type": "array"
    }
  },
  "required": [
    "request",
    "collector_id",
    "collector_version",
    "objects",
    "gaps"
  ],
  "title": "CollectionResult",
  "type": "object"
}
