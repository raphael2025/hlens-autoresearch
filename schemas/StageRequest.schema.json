{
  "additionalProperties": false,
  "description": "一次 staging 请求：目标 key + 预期 SHA-256（必填）+ 可选的预期字节数。\n\n内容本身不在 DTO 内：字节块流作为 `StorageAdapter.stage` 的独立参数传入，不把完整文件放进模型。",
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "key": {
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,254}(?:/[A-Za-z0-9][A-Za-z0-9._=-]{0,254})*$",
      "title": "Key",
      "type": "string"
    },
    "expected_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Sha256",
      "type": "string"
    },
    "expected_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Size"
    }
  },
  "required": [
    "key",
    "expected_sha256"
  ],
  "title": "StageRequest",
  "type": "object"
}
