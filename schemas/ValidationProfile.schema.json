  "additionalProperties": false,
  "description": "按\"标的 × 周期 × 研究类别\"给出的版本化阈值集合。\n\n不可变性：`status = frozen` 的版本永不修改；修正 = 新版本（Constitution C-A5）。\n完整性：五类门槛必须齐全，否则 Profile 无效（Constitution C-A7）。",
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "profile",
      "default": "profile",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "created_at": {
